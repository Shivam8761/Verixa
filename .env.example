# VERIXA Environment Variables Template

PORT=8080

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/verixa_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT Security
JWT_SECRET=verixa_super_secret_jwt_key_that_is_at_least_32_bytes_long_1234567890!
JWT_EXPIRATION_MS=86400000

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# AI LLM Provider Configuration
AI_API_KEY=your_gemini_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-1.5-flash

# Code Execution Engine (Judge0 / Sandbox)
CODE_EXECUTION_URL=https://judge0-ce.p.rapidapi.com
CODE_EXECUTION_API_KEY=your_rapid_api_key_if_using_judge0
